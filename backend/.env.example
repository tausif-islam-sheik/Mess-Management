# PostgreSQL connection string (update user / password / db name)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/messdb?schema=public"

# Random secret for signing JWT access tokens
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Port the API listens on
PORT=3001

# Frontend origin allowed by CORS (comma-separated for more than one)
FRONTEND_URL="http://localhost:3000"
